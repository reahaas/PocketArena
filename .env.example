# Optional. Leave unset: the client talks to /ws on its own origin, which works in dev
# (proxied by Vite) and in production (served by the signaling process).
VITE_SIGNALING_URL=
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_DEBUG_NETWORK_LATENCY_MS=0
VITE_DEBUG_PACKET_LOSS_PERCENT=0

# Server
PORT=8787
# Set to the built client directory to serve everything from one process and port.
STATIC_DIR=
ALLOWED_ORIGINS=
