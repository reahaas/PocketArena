{
  "name": "pocket-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first browser multiplayer arena. Host-authoritative WebRTC, up to 20 players, invite by link.",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,sig -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "serve": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:docker": "npm run docker:up && E2E_BASE_URL=http://localhost:8080 playwright test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
